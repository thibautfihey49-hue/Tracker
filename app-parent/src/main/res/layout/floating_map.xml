<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="20dp" app:cardElevation="8dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <org.osmdroid.views.MapView android:id="@+id/floatingMap" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/dragHandle" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="28dp" android:background="#AA000000" android:gravity="center_vertical" android:padding="4dp">
            <TextView android:id="@+id/miniStatus" android:text="📍 ±10m" android:textSize="10sp" android:textColor="#FFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <ImageView android:id="@+id/btnExpand" android:src="@android:drawable/ic_menu_view" android:layout_width="24dp" android:layout_height="24dp" android:padding="2dp"/>
            <ImageView android:id="@+id/btnClose" android:src="@android:drawable/ic_menu_close_clear_cancel" android:layout_width="24dp" android:layout_height="24dp" android:padding="2dp"/>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
